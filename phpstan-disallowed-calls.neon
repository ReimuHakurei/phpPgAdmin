# The domain (src/DDD/) has no side effects. PHPat only checks the dependencies between classes, so these rules forbid
# what reaches the outside world without a class: superglobals, programs, the file system, the log and HTTP.
parameters:
    filesRootDir: %rootDir%/../../..
    disallowedSuperglobals:
        -
            superglobal:
                - '$GLOBALS'
                - '$_COOKIE'
                - '$_ENV'
                - '$_FILES'
                - '$_SERVER'
                - '$_SESSION'
            message: 'the domain gets its input as parameters, PhpPgAdmin\Infrastructure reads it.'
            allowExceptIn:
                - src/DDD/*
        # The rest of src/ reads the request only through RequestParameter. This entry covers src/DDD/ as well, because
        # a later entry for the same superglobal replaces an earlier one.
        -
            superglobal:
                - '$_GET'
                - '$_POST'
                - '$_REQUEST'
            message: 'PhpPgAdmin\Infrastructure\Http\RequestParameter reads the request, the domain gets it as parameters.'
            allowIn:
                - src/Infrastructure/Http/*
            allowExceptIn:
                - src/*
    disallowedFunctionCalls:
        -
            function:
                - 'exec()'
                - 'passthru()'
                - 'pcntl_exec()'
                - 'popen()'
                - 'proc_open()'
                - 'shell_exec()' # also the backtick operator
                - 'system()'
            message: 'the domain runs no programs, PhpPgAdmin\Infrastructure does.'
            allowExceptIn:
                - src/DDD/*
        -
            function:
                - 'chdir()'
                - 'chgrp()'
                - 'chmod()'
                - 'chown()'
                - 'chroot()'
                - 'clearstatcache()'
                - 'closedir()'
                - 'copy()'
                - 'dir()'
                - 'disk_free_space()'
                - 'disk_total_space()'
                - 'diskfreespace()'
                - 'fclose()'
                - 'fdatasync()'
                - 'feof()'
                - 'fflush()'
                - 'fgetc()'
                - 'fgetcsv()'
                - 'fgets()'
                - 'file*()'
                - 'flock()'
                - 'fopen()'
                - 'fpassthru()'
                - 'fputcsv()'
                - 'fputs()'
                - 'fread()'
                - 'fscanf()'
                - 'fseek()'
                - 'fstat()'
                - 'fsync()'
                - 'ftell()'
                - 'ftruncate()'
                - 'fwrite()'
                - 'getcwd()'
                - 'glob()'
                - 'is_dir()'
                - 'is_executable()'
                - 'is_file()'
                - 'is_link()'
                - 'is_readable()'
                - 'is_uploaded_file()'
                - 'is_writable()'
                - 'is_writeable()'
                - 'lchgrp()'
                - 'lchown()'
                - 'link()'
                - 'linkinfo()'
                - 'lstat()'
                - 'mkdir()'
                - 'move_uploaded_file()'
                - 'opendir()'
                - 'parse_ini_file()'
                - 'readdir()'
                - 'readfile()'
                - 'readlink()'
                - 'realpath()'
                - 'rename()'
                - 'rewind()'
                - 'rewinddir()'
                - 'rmdir()'
                - 'scandir()'
                - 'stat()'
                - 'symlink()'
                - 'tempnam()'
                - 'tmpfile()'
                - 'touch()'
                - 'umask()'
                - 'unlink()'
            message: 'the domain does not touch the file system, PhpPgAdmin\Infrastructure does.'
            allowExceptIn:
                - src/DDD/*
        -
            function:
                - 'closelog()'
                - 'error_log()'
                - 'openlog()'
                - 'syslog()'
            message: 'the domain does not log, it throws exceptions.'
            allowExceptIn:
                - src/DDD/*
        -
            function:
                - 'header*()'
                - 'http_response_code()'
                - 'session_*()'
                - 'setcookie()'
                - 'setrawcookie()'
            message: 'the domain knows nothing of HTTP, the pages and PhpPgAdmin\Infrastructure do.'
            allowExceptIn:
                - src/DDD/*
    disallowedClasses:
        -
            class:
                - 'Directory'
                - 'DirectoryIterator'
                - 'FilesystemIterator'
                - 'GlobIterator'
                - 'RecursiveDirectoryIterator'
                - 'SplFileInfo'
                - 'SplFileObject'
                - 'SplTempFileObject'
            message: 'the domain does not touch the file system, PhpPgAdmin\Infrastructure does.'
            allowExceptIn:
                - src/DDD/*
